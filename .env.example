# 复制为 .env 并填写密钥，权限保持 600。agent 配置（configs/agents/*.yaml）与
# bench 配置（configs/benches/*.yaml）用 ${VAR} 引用这里的变量，缺失时 Harbor 直接报错。

# ── deepseek ──────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_OPENAI_MODEL_ID=deepseek-flash

# ── go（opencode 网关）────────────────────────────────────────────────
# mimo-v2.6-flash 只在 OpenAI 协议端点，claude-haiku-5-5 只在 Anthropic 协议端点。
GO_API_KEY=
GO_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
GO_ANTHROPIC_BASE_URL=https://opencode.ai/zen/go

# ── stepfun（OpenAI 兼容端点）─────────────────────────────────────────
STEPFUN_API_KEY=
STEPFUN_OPENAI_BASE_URL=https://your-model-endpoint.example/v1

# ── LLM judge：评分器的评审模型，与被测模型分开配置 ─────────────────────
# 值可以引用上面的变量（.env 支持 ${VAR} 展开）。
JUDGE_BASE_URL=${DEEPSEEK_OPENAI_BASE_URL}
JUDGE_API_KEY=${DEEPSEEK_API_KEY}
JUDGE_MODEL=${DEEPSEEK_OPENAI_MODEL_ID}
